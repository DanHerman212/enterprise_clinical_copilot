# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real project identifiers or secrets.

# --- Required --------------------------------------------------------------
PROJECT_ID=your-gcp-project-id

# --- Optional overrides (uncomment to change the script's defaults) ---------
REGION=us-east1
PIPELINE_SA_NAME=mlops-pipeline
# GCS_BUCKET=          # defaults to ${PROJECT_ID}-mlops
BQ_DATASET=readmission

# --- PubMed literature search (the `search_literature` tool) ---------------
# NCBI's E-utilities usage policy asks every caller to identify itself, so the
# tool reports itself as unconfigured rather than calling out anonymously when
# the address is missing.
#
# The API key is recommended rather than required. Measured 2026-10-08: without
# one, NCBI allows 3 requests per second per source address and a search is two
# requests, so a second search in quick succession is refused with 429. The tool
# retries a bounded number of times, which covers an isolated burst — but the
# limit is per address, and Cloud Run presents one egress address for every
# instance, so that budget is shared across users rather than granted to each.
# A key raises it to 10 requests per second. Register one under Account Settings
# at https://www.ncbi.nlm.nih.gov/account/
NCBI_EMAIL=you@example.com
NCBI_API_KEY=your-ncbi-api-key
