# --- Data (never commit MIMIC-IV or any PHI-derived artifact) --------------
# `data/*` rather than `data/`: the directory itself must stay traversable so the
# public-safe synthetic cohort manifests below can be re-included. A directory
# exclusion cannot be undone for a file inside it, which is why this is not the
# single-line form it used to be. Everything except the two named manifests under
# data/agent/ is still ignored, and every PHI-derived artifact still is.
data/*
!data/agent/
data/agent/*
!data/agent/demo_cohort.json
!data/agent/demo_fixtures/
data/agent/demo_fixtures/*
!data/agent/demo_fixtures/demo_cohort.json
*.csv
*.parquet
*.feather
*.tsv
*.xlsx

# --- Models / large artifacts ----------------------------------------------
*.pkl
*.joblib
*.h5
*.onnx
*.bst
models/
artifacts/

# --- Editor / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# do not upload the archive folder to github
Archive/

.venv-311/
.venv-kfp/
.venv-nlp/

# --- Node / Dataform -------------------------------------------------------
node_modules/

# --- Agent eval runtime artifacts (regenerable; durable trace archive is GCP) ---
projects/agent-harness/eval/results/*.log
projects/agent-harness/eval/results/*.jsonl
projects/agent-harness/eval/results/*.txt
evaluation/agent/results/*.log
evaluation/agent/results/*.jsonl
evaluation/agent/results/*.txt
# Same reasoning as `data/` above: the directory stays traversable, its contents
# are ignored by kind, and only the two census manifests the test suite asserts
# against are re-included. They carry hadm ids, bands and probabilities — no note
# text. `hybrid_notes.json` is named further down and stays ignored because the
# later rule wins.
evaluation/agent/results/*.json
evaluation/agent/results/*/
!evaluation/agent/results/cases_82.json
!evaluation/agent/results/cases_outpatient.json

# --- Hybrid cohort: real MTSamples note TEXT stays out of git (raw-text rule).
# The features-only hybrid_cohort.json IS tracked; the notes artifact is not. ---
projects/agent-harness/eval/results/hybrid_notes.json
evaluation/agent/results/hybrid_notes.json

# don't sync obsidian json files
docs/.obsidian 

# --- UX workshop capture ---------------------------------------------------
# The capture stays out: screenshots and verbatim turn outputs quote
# discharge-note text directly — the same raw-text rule that keeps the hybrid
# notes artifact out of git — and it is reproducible from the procedure document.
#
# The practice record IS tracked (2026-10-13): the strategy-and-tactics documents
# and the capture procedure describe how the workshop was run, quote no note text,
# and are the artifacts worth sharing.
docs/ux_workshop/screenshots/
docs/ux_workshop/turns/
docs/ux_workshop/phase1/live/
# Clean context archives (generated for review, never committed)
/*-clean.zip

# Plain-text context bundles (generated for review, never committed)
*-code-bundle.txt
