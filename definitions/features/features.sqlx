config {
  type: "table",
  schema: "readmission_features",
  description: "Wide feature table joined to the split cohort. Built AFTER the split so feature logic never crosses the train/val/test boundary."
}

-- Phase 2 §3 — Core Features.
-- One wide row per admission. In practice each feature group (demographics,
-- utilization, codes, meds, labs, notes) can be its own intermediate model
-- ref()'d here; kept as a single stub for now.
--
-- Data is joined from per-group feature models. Note-derived features 
-- to be added here once BioClinicalBERT/triage extraction is complete.
-- feat_target produces the 30-day readmission label (supervised target).

SELECT
  s.*,
  fd.* EXCEPT(hadm_id),
  fu.* EXCEPT(hadm_id),
  fc.* EXCEPT(hadm_id),
  fm.* EXCEPT(hadm_id),
  fl.* EXCEPT(hadm_id),
  ft.* EXCEPT(hadm_id)
FROM ${ref("cohort_split")} AS s
LEFT JOIN ${ref("feat_demographics")} AS fd USING (hadm_id)
LEFT JOIN ${ref("feat_utilization")}  AS fu USING (hadm_id)
LEFT JOIN ${ref("feat_codes")}        AS fc USING (hadm_id)
LEFT JOIN ${ref("feat_medications")}  AS fm USING (hadm_id)
LEFT JOIN ${ref("feat_labs")}         AS fl USING (hadm_id)
LEFT JOIN ${ref("feat_target")}       AS ft USING (hadm_id)
