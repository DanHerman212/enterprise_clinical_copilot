config {
  type: "table",
  schema: "readmission_features",
  description: "Feature table after missingness handling. Imputation statistics are computed from training rows only to avoid leakage."
}

-- Phase 2 §4 — Data Transformation / Missingness.
-- Policy per column: impute (train-derived statistic), add a missingness
-- indicator, or drop. Fill values are computed from split_bucket = 'train'
-- ONLY, then joined back to all rows — this is the leak-safe pattern.
--
-- IMPUTATION DEFERRED: We are passing missing values (NULLs) through directly
-- to the analytics dataset. Missingness will be handled natively by the model 
-- algorithm (e.g. LightGBM / XGBoost) or via BigQuery ML's TRANSFORM clause 
-- during training.

SELECT
  f.*
FROM ${ref("features")} AS f
