config {
  type: "table",
  schema: "readmission_staging",
  description: "Cohort spine: one row per qualifying INPATIENT, non-elective admission with LOS >= 24h. Identity + timing only (subject_id, hadm_id, admittime, dischtime); demographics and the 30-day label join on in later layers."
}

-- Phase 2 §1 — Cohort Definition (the spine).
-- Grain: one row per qualifying hadm_id. subject_id carried for the
-- subject-level split (leakage guard). Skinny by design.
--
-- Inclusion: adult, discharged alive, INPATIENT (not an observation stay),
--             non-elective, and LOS >= 24h.
-- Exclusion: died during index admission; LOS < 24h; planned admissions
--            (ELECTIVE / SURGICAL SAME DAY ADMISSION); observation stays
--            (OBSERVATION ADMIT / EU OBSERVATION / DIRECT OBSERVATION /
--            AMBULATORY OBSERVATION); and contiguous stays (re-admit within
--            24h of prior discharge -> keep first).
--
-- Prototyped and validated in notebooks/data_representation.ipynb.
-- The admission_type filter mirrors feat_target.sqlx so the outcome label
-- uses the same inpatient / non-elective / >= 24h definition as the cohort.

WITH base AS (
  SELECT
    a.subject_id,
    a.hadm_id,
    a.admittime,
    a.dischtime,
    p.anchor_age,
    a.hospital_expire_flag,
    a.deathtime,
    a.admission_type,
    TIMESTAMP_DIFF(a.dischtime, a.admittime, HOUR) AS los_hours,
    LAG(a.dischtime) OVER (
      PARTITION BY a.subject_id ORDER BY a.admittime
    ) AS prev_dischtime
  FROM ${ref("admissions")} AS a
  JOIN ${ref("patients")} AS p
    USING (subject_id)
),

flagged AS (
  SELECT
    *,
    (
      prev_dischtime IS NOT NULL
      AND TIMESTAMP_DIFF(admittime, prev_dischtime, HOUR) <= 24
    ) AS is_continuation
  FROM base
)

SELECT
  subject_id,
  hadm_id,
  admittime,
  dischtime
FROM flagged
WHERE anchor_age >= 18                                              -- adult
  AND hospital_expire_flag = 0 AND deathtime IS NULL                -- discharged alive
  AND los_hours >= 24                                               -- LOS >= 1 day
  AND admission_type NOT IN (                                      -- inpatient, non-elective
    'ELECTIVE', 'SURGICAL SAME DAY ADMISSION',
    'OBSERVATION ADMIT', 'EU OBSERVATION',
    'DIRECT OBSERVATION', 'AMBULATORY OBSERVATION'
  )
  AND NOT is_continuation                                           -- collapse contiguous stays
